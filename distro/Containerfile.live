# The live USB: OmniLaunch OS that boots from a USB stick (try it without installing), with an
# installer that puts OmniLaunch OS on the disk. Built on top of the OS image:
#   sudo podman build -t localhost/omnilaunch-os-live -f distro/Containerfile.live .
# What the installer installs is the OS image as an OCI folder, attached at
# /usr/share/omnilaunch-os/payload when titanoboa (github.com/ublue-os/titanoboa) turns this image
# into an .iso. See .github/workflows/distro.yml for the exact commands.
# (No comment line here may end in a backslash: the build tool joins it to the next line.)
FROM localhost/omnilaunch-os:latest

COPY distro/live /src
RUN bash /src/build.sh && rm -rf /src
