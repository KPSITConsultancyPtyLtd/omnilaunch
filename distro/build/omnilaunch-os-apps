#!/usr/bin/bash
# Installs OmniLaunch OS's chosen apps from Flathub, in the background, after the first start (and any
# new ones a later OmniLaunch OS version adds). Each app is installed once: one the user removes stays
# removed. Apps that fail (no internet, say) are tried again at the next start.
set -uo pipefail
list=/usr/share/omnilaunch-os/apps.list
state=/var/lib/omnilaunch-os
installed=$state/apps-installed
status=$state/apps-status
arch=$(uname -m)
# Which apps: "full" (default: everything in the list) or "essential" (skips sections marked [optional],
# the large creative and games downloads). Set by writing the word to /etc/omnilaunch-os/apps-profile.
profile=$(tr -d '[:space:]' < /etc/omnilaunch-os/apps-profile 2>/dev/null || true)
profile=${profile:-full}
case "$profile" in essential|full) ;; *) echo "Unknown apps profile '$profile' (use essential or full)" >&2; exit 2 ;; esac
section=essential
mkdir -p "$state"
touch "$installed"

flatpak remote-add --system --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo 2>/dev/null ||
    flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

todo=()
while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == "# ----"* ]]; then                 # a section heading
        [[ $line == *"[optional]"* ]] && section=optional || section=essential
        continue
    fi
    [[ $line == \#* ]] && continue
    [[ $profile == essential && $section == optional ]] && continue
    read -r id archs _ <<< "$line"
    [[ -z $id || $id == \#* ]] && continue
    [[ -n $archs && $archs != \#* && ,$archs, != *,$arch,* ]] && continue
    grep -qxF "$id" "$installed" || todo+=("$id")
done < "$list"

if ((${#todo[@]} == 0)); then echo done > "$status"; exit 0; fi
failed=()
n=0
for id in "${todo[@]}"; do
    n=$((n + 1))
    echo "installing $n of ${#todo[@]}: $id" > "$status"
    if flatpak install --system --noninteractive --or-update flathub "$id"; then
        echo "$id" >> "$installed"
    else
        failed+=("$id")
    fi
done
if ((${#failed[@]})); then
    echo "will retry: ${failed[*]}" > "$status"
    exit 1
fi
echo done > "$status"
