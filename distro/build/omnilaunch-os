#!/usr/bin/bash
# omnilaunch-os: look after OmniLaunch OS in plain words.
#   omnilaunch-os status      what's installed and whether an update is waiting
#   omnilaunch-os update      download the newest OmniLaunch OS now (used on the next restart)
#   omnilaunch-os rollback    go back to the previous version on the next restart
#   omnilaunch-os apps        open the app store (Discover) and show app setup progress
#   omnilaunch-os install X   find and install an app, e.g.  omnilaunch-os install spotify
#   omnilaunch-os defaults    choose which app opens web links, email, music, videos...
#   omnilaunch-os enroll-key  let the NVIDIA driver load with Secure Boot on
set -euo pipefail
need_root() { if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi; }

case ${1:-status} in
    status)
        . /usr/lib/os-release
        echo "$PRETTY_NAME"
        echo "Kernel: $(uname -r)"
        bootc status --format=humanreadable 2>/dev/null || bootc status
        ;;
    update|upgrade)
        need_root "$@"
        echo "Checking for a newer OmniLaunch OS..."
        bootc upgrade
        echo "If an update was downloaded, it's used from the next restart. Your files and apps stay."
        ;;
    apps)
        if [[ ${2:-} == essential || ${2:-} == full ]]; then
            need_root "$@"
            mkdir -p /etc/omnilaunch-os && echo "$2" > /etc/omnilaunch-os/apps-profile
            echo "App set: $2. (Switching never removes apps; remove any you don't want in Discover.)"
            systemctl restart --no-block omnilaunch-os-apps.service
            exit 0
        fi
        echo "App set: $(cat /etc/omnilaunch-os/apps-profile 2>/dev/null || echo full)" \
             "(change with: omnilaunch-os apps essential|full)"
        echo "App setup: $(cat /var/lib/omnilaunch-os/apps-status 2>/dev/null || echo 'not started')"
        (plasma-discover >/dev/null 2>&1 &)
        ;;
    install)
        shift
        [[ $# -gt 0 ]] || { echo "usage: omnilaunch-os install <app name>" >&2; exit 2; }
        flatpak install flathub "$@"     # asks which match you mean, then installs it
        ;;
    defaults)
        (systemsettings kcm_componentchooser >/dev/null 2>&1 &)
        echo "For a particular kind of file: right-click one → Open With → Other Application, and tick 'Remember'."
        ;;
    rollback)
        need_root "$@"
        bootc rollback
        echo "The previous version is used from the next restart. (You can also pick it in the boot menu.)"
        ;;
    enroll-key)
        need_root "$@"
        cert=/usr/share/omnilaunch-os/secure-boot.der
        if [[ ! -f $cert ]]; then
            echo "This build's NVIDIA driver isn't signed. Turn Secure Boot off in your PC's firmware settings,"
            echo "or see distro/make-secure-boot-key.sh in the OmniLaunch repository."
            exit 1
        fi
        echo "Choose a one-time password. After restarting, a blue 'MOK management' screen appears:"
        echo "choose Enroll MOK, Continue, Yes, type this password, then Reboot."
        mokutil --import "$cert"
        ;;
    -h|--help|help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "Unknown command: $1 (try: omnilaunch-os help)" >&2; exit 2 ;;
esac
