# Apps OmniLaunch OS installs from Flathub on first start (in the background, once per app: an app the
# user removes isn't put back). Flathub apps update on their own and can be removed in Discover.
# Format: <Flathub app id>  [architectures, if not all]   # what it is
# Sections marked [optional] are skipped when /etc/omnilaunch-os/apps-profile says "essential".

# ---- Everyday
org.mozilla.Thunderbird                     # email and calendar
org.libreoffice.LibreOffice                 # office suite: Word, Excel and PowerPoint files
org.kde.okular                              # PDFs: read, fill in forms, sign, annotate (Acrobat Reader)
org.kde.gwenview                            # photo viewer
org.videolan.VLC                            # plays any video or music file
org.kde.elisa                               # music library
org.kde.kate                                # text and code editor
org.kde.ark                                 # zip, 7z, rar and other archives
org.kde.kcalc                               # calculator
org.localsend.localsend_app                 # send files to nearby phones and computers (like AirDrop)
org.keepassxc.KeePassXC                     # password manager

# ---- Creative suite (open-source alternatives to Adobe's apps) [optional]
org.gimp.GIMP                               # photo editing (Photoshop)
org.kde.krita                               # digital painting (Photoshop/Fresco painting)
org.inkscape.Inkscape                       # vector graphics (Illustrator)
org.darktable.Darktable                     # RAW photo development and library (Lightroom)
org.kde.kdenlive                            # video editing (Premiere Pro)
org.blender.Blender                         # 3D, motion graphics and compositing (After Effects, Dimension)
net.scribus.Scribus                         # page layout and print (InDesign)
org.audacityteam.Audacity                   # audio editing (Audition)
com.obsproject.Studio                       # screen recording and live streaming
fr.handbrake.ghb                            # convert and compress videos (Media Encoder)

# ---- Games [optional]
com.heroicgameslauncher.hgl  x86_64         # Epic Games, GOG and Amazon games
net.davidotek.pupgui2        x86_64         # newer Proton versions for Steam and Heroic

# ---- Looking after apps
com.github.tchx84.Flatseal                  # see and change what each app may access
